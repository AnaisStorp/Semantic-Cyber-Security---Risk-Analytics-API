# Copy to .env and adjust. Every variable is optional - the defaults in
# app/config.py apply when a variable is absent.

SCSRA_DEBUG=false

# Minimum CVSS v3.1 base score for a vulnerability to count as exploitable.
# 7.0 is the boundary between MEDIUM and HIGH.
SCSRA_CVSS_THRESHOLD=7.0

# Maximum hops explored when enumerating attack paths.
SCSRA_MAX_ATTACK_DEPTH=6

# The raw SPARQL endpoint has no query timeout (see app/api/routes/sparql.py).
# Disable it for any deployment that is not a controlled demo.
SCSRA_ENABLE_SPARQL_ENDPOINT=true
SCSRA_SPARQL_MAX_ROWS=1000
